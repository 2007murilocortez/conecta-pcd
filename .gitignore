# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.p12
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local
supabase/.temp/
supabase/.branches/
supabase/.env

# editor / local
.idea/
.vscode/
!.vscode/extensions.json
.cursor/

# archives e backups locais
*.zip
*.rar
*.7z

# logs
*.log
logs/
